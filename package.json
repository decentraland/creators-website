{
  "name": "@dcl/wemotes-builder-site",
  "version": "0.0.1",
  "description": "Wearables & Emotes Creator Tools for Decentraland",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "prebuild": "node scripts/prebuild.cjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:coverage": "npm run test -- --coverage",
    "typecheck": "tsc -b",
    "prepare": "simple-git-hooks",
    "format": "prettier --check \"**/*.{js,mjs,cjs,ts,tsx,json,css,html,md,mdx}\" --log-level=error",
    "format:fix": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx,json,css,html,md,mdx}\" --log-level=error",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "simple-git-hooks": {
    "pre-commit": "npx nano-staged && npm run typecheck"
  },
  "nano-staged": {
    "src/**/*.{js,mjs,cjs,ts,tsx}": "eslint --fix",
    "**/*.{js,mjs,cjs,ts,tsx,json,css,html,md,mdx}": "prettier --write --log-level=error"
  },
  "dependencies": {
    "@dcl/hooks": "^1.2.1",
    "@dcl/ui-env": "^2.0.0",
    "decentraland-ui2": "^3.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^10.1.22",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "nano-staged": "^1.0.2",
    "prettier": "^3.9.5",
    "simple-git-hooks": "^2.13.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.2.1"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/decentraland/wemotes-builder.git"
  },
  "keywords": [
    "decentraland",
    "wearables",
    "emotes",
    "creator",
    "builder"
  ],
  "author": "Decentraland",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/decentraland/wemotes-builder/issues"
  },
  "homepage": "",
  "engines": {
    "node": ">=24",
    "npm": ">=8"
  }
}
