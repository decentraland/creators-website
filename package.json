{
  "name": "@dcl/wemotes-builder-site",
  "version": "0.0.1",
  "description": "Wearables & Emotes Creator Tools for Decentraland",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "prebuild": "node scripts/prebuild.cjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "prepare": "simple-git-hooks",
    "format": "prettier --check \"**/*.{js,mjs,cjs,ts,tsx,json,css,html,md,mdx}\" --log-level=error",
    "format:fix": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx,json,css,html,md,mdx}\" --log-level=error",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "simple-git-hooks": {
    "pre-commit": "npx nano-staged && npm run typecheck"
  },
  "nano-staged": {
    "src/**/*.{js,mjs,cjs,ts,tsx}": "eslint --fix",
    "**/*.{js,mjs,cjs,ts,tsx,json,css,html,md,mdx}": "prettier --write --log-level=error"
  },
  "dependencies": {
    "@dcl/crypto": "^3.7.0",
    "@dcl/hashing": "^1.2.0",
    "@dcl/hooks": "^1.5.0",
    "@dcl/schemas": "^26.5.0",
    "@dcl/single-sign-on-client": "^3.0.1",
    "@dcl/social-rpc-client": "^2.0.1",
    "@dcl/ui-env": "^2.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "@sentry/react": "^9.47.1",
    "@tanstack/react-query": "^5.101.4",
    "decentraland-connect": "^12.1.1",
    "decentraland-transactions": "^3.1.1",
    "decentraland-ui2": "3.23.2",
    "ethers": "^5.8.0",
    "isbot": "^5.2.2",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-datepicker": "^7.6.0",
    "react-dom": "^18.3.1",
    "react-intl": "^10.1.22",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.6",
    "three": "^0.185.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sentry/vite-plugin": "^2.23.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "nano-staged": "^1.0.2",
    "prettier": "^3.9.8",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/decentraland/wemotes-builder.git"
  },
  "keywords": [
    "decentraland",
    "wearables",
    "emotes",
    "creator",
    "builder"
  ],
  "author": "Decentraland",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/decentraland/wemotes-builder/issues"
  },
  "homepage": "",
  "engines": {
    "node": ">=24",
    "npm": ">=8"
  }
}
