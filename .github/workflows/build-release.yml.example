name: Build and release

on:
  push:
    branches:
      - master
  release:
    types:
      - created

jobs:
  build-release:
    runs-on: ubuntu-latest

    permissions:
      id-token: write

    steps:
      - uses: actions/checkout@main

      - name: Use Node.js 20.x
        uses: actions/setup-node@v4.0.1
        with:
          node-version: 24

      - name: Set package.json version
        uses: decentraland/oddish-action@master
        with:
          deterministic-snapshot: true
          only-update-versions: true

      - name: Install
        run: npm ci
        env:
          HUSKY: 0

      - name: Build
        run: npm run build
        env:
          NODE_OPTIONS: '--max-old-space-size=6144'
          # Source maps for Sentry. This is the build that produces the bundle creators run, so it is
          # the only place its maps can come from — without the token every stack trace stays minified.
          # vite.config gates the whole thing on the token: it turns `build.sourcemap` on, uploads under
          # the same release name the runtime reports, then DELETES the .map files so they never reach
          # the CDN. An absent or empty secret restores exactly the previous behaviour.
          SENTRY_AUTH_TOKEN: ${{ secrets.SENTRY_AUTH_TOKEN }}
          # Not secrets — the slugs in every Sentry URL for this app. The project is the LEGACY
          # BUILDER's: this app shares its Sentry project (same SENTRY_DSN in src/config/env/*.json).
          SENTRY_ORG: decentraland
          SENTRY_PROJECT: builder

      # Belt and braces: the build deletes the maps right after uploading them, and fails outright if
      # the upload fails. This guarantees a .map can never reach the CDN even if that ever changes.
      - name: Drop any leftover source maps
        run: find dist -name '*.map' -delete

      - name: Publish
        uses: decentraland/oddish-action@master
        with:
          cwd: './dist'
          deterministic-snapshot: true
          provenance: false
          registry-url: 'https://registry.npmjs.org'
          access: public
          gitlab-token: ${{ secrets.GITLAB_CDN_DEPLOYER_TOKEN }}
          gitlab-pipeline-url: ${{ secrets.GITLAB_CDN_DEPLOYER_URL }}
        env:
          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
